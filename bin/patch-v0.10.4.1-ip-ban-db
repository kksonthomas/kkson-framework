#!/usr/bin/env php
<?php

/**
 * v0.10.4.1 — optional IP ban performance DB patch (idempotent).
 *
 * Run from your application project root (where conf/db.config.*.ini exists):
 *   vendor/bin/patch-v0.10.4.1-ip-ban-db
 */

use KKsonFramework\App\MySQLiHelper;
use KKsonFramework\Database\PatchV010041IpBanDb;

$autoloadPaths = [
    __DIR__ . "/../../autoload.php",
    __DIR__ . "/../vendor/autoload.php",
];

$loaded = false;
foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        require $path;
        $loaded = true;
        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "Composer autoload not found. Run from a project with vendor/autoload.php.\n");
    exit(1);
}

if (!is_dir(getcwd() . "/conf") && is_dir(__DIR__ . "/../conf")) {
    chdir(__DIR__ . "/..");
}

echo "KKson Framework DB patch " . PatchV010041IpBanDb::VERSION . " (IP ban performance)\n";
echo "Working directory: " . getcwd() . "\n";

try {
    $patch = new PatchV010041IpBanDb(new MySQLiHelper());
    $patch->run();
    echo "Done.\n";
    exit(0);
} catch (Throwable $e) {
    fwrite(STDERR, "Patch failed: " . $e->getMessage() . "\n");
    exit(1);
}
